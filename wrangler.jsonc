// Cloudflare Worker config: serves the app from docs/ and runs worker/index.js for /api/*.
// Cloudflare deploy command: npx wrangler deploy
{
  "name": "piratestudios-checker",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
